{
  "manifest_version": 3,
  "name": "ttpull",
  "version": "1.1.0",
  "description": "Copies your signed-in session to your ttpull container. Does not read or change the pages you visit.",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.1.3/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ttpull"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
